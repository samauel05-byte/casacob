# --- Supabase (tu base de datos) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (lo usa el cron de recordatorios automáticos). NUNCA exponer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Negocio ---
BUSINESS_NAME=Mi Empresa

# --- Correo (Resend: https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Mi Empresa <cobros@tudominio.com>"

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número habilitado para WhatsApp, formato E.164, ej: +14155238886
TWILIO_WHATSAPP_FROM=

# --- Cron (Vercel envía este secreto como Bearer) ---
CRON_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
